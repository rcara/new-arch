# Exemple d'unité systemd — à installer sur le VPS :
#   sudo cp deploy/foyer.service /etc/systemd/system/foyer.service
#   # adapter User=, WorkingDirectory=, Environment=FOYER_HOME=
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now foyer
#
# L'app reste sur 127.0.0.1:8765 (launcher.py). Exposition publique = Cloudflare Tunnel.

[Unit]
Description=New Arch (locale, 127.0.0.1)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=foyer
Group=foyer
WorkingDirectory=/opt/foyer
Environment=FOYER_HOME=/opt/foyer
Environment=FOYER_PORT=8765
Environment=FOYER_NO_BROWSER=1
# Host/Origin vus par l'app via le Tunnel (sinon « Hôte refusé »). Adapter le domaine.
Environment=FOYER_PUBLIC_HOST=new-arch.arscodicis.net
Environment=FOYER_PUBLIC_ORIGIN=https://new-arch.arscodicis.net
# Google Calendar OAuth : NE PAS mettre CLIENT_ID/SECRET ici (secrets).
# Drop-in recommandé : /etc/systemd/system/foyer.service.d/google-oauth.conf
#   Environment=FOYER_GOOGLE_CLIENT_ID=…
#   Environment=FOYER_GOOGLE_CLIENT_SECRET=…
#   Environment=FOYER_GOOGLE_REDIRECT_URI=https://new-arch.arscodicis.net/oauth/google/callback
ExecStart=/opt/foyer/.venv/bin/python /opt/foyer/launcher.py
Restart=on-failure
RestartSec=3
# Pas d'écoute publique : le tunnel Cloudflare se connecte en local.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
